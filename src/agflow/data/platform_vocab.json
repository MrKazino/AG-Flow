  "hook_events": ["PreToolUse", "PostToolUse", "PreInvocation", "PostInvocation", "Stop"],
  "hook_events_grouped": ["PreToolUse", "PostToolUse"],
  "hook_payload_keys": {
    "tool_call": ["toolCall"],
    "tool_name": ["tool_name", "toolName", "tool", "name"],
    "tool_args": ["tool_input", "toolInput", "args", "arguments", "input", "parameters"],
    "command": ["CommandLine", "command_line", "commandLine", "command", "cmd"],
    "path": ["AbsolutePath", "TargetFile", "FilePath", "file_path", "path", "filePath", "target_file"],
    "workspace": ["workspacePaths", "workspace", "workspacePath", "workspace_root", "cwd", "project_dir"],
    "common": ["conversationId", "stepIdx", "workspacePaths", "transcriptPath", "modelName"]
  },
  "_hook_payload_source": "tool_call/common/workspacePaths: Antigravity's own docs (agy-customizations/docs/hooks.md: toolCall {name, args}, camelCase protojson); the other variants are earlier guesses kept for compatibility",
  "workflows_retired_on": "2026-11-01"
}
