{
  "agflow": {
    "PreToolUse": [
      {
        "matcher": ".*(command|file|code_action|write|replace|edit).*",
        "hooks": [
          {
            "type": "command",
            "command": "agflow hook pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*(command|write|replace|edit|code_action|subagent).*",
        "hooks": [
          {
            "type": "command",
            "command": "agflow hook post-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "agflow hook stop",
        "timeout": 10
      }
    ]
  }
}
